#!/usr/bin/env bash

# Install rust-analyzer
if [[ "$(uname)" == "Linux" ]]; then
    if uname -a 2>/dev/null | grep -q "arch"; then
        sudo pacman -S rust-analyzer
    fi
elif [[ "$(uname)" == "Darwin" ]]; then
    # Neovim prefers the analyzer matching each project's toolchain (see
    # .config/nvim/lua/plugins/rust.lua). Pinned toolchains from
    # rust-toolchain.toml need their own `--toolchain <name>` install.
    rustup component add rust-analyzer
else
    echo "This OS is not supported."
fi

